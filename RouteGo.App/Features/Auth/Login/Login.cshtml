@page
@model RouteGo.App.Features.Auth.Login.LoginModel
@{ ViewData["Title"] = "Sign in"; }

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-7 col-xl-6"><div class="form-card">
        <h1 class="mb-4">Sign in</h1>
        <partial name="_PageAlert" model="Model.Alert" />

        <form method="post" novalidate data-login-form>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" type="email" class="form-control" autocomplete="email" aria-describedby="email-error" />
                <span asp-validation-for="Input.Email" id="email-error" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-describedby="password-error" />
                <span asp-validation-for="Input.Password" id="password-error" class="invalid-feedback d-block"></span>
            </div>
            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>

        <ul class="list-unstyled mt-4" data-login-links>
            <li class="mb-2">New to RouteGo? <a href="/auth/register">Create an account</a></li>
            <li class="mb-2"><a href="/auth/resend-verification">Didn't get the verification email?</a></li>
            <li>Are you a bus company? <a href="/operator/apply">Apply as a bus operator</a></li>
        </ul>
    </div></div>
</div>
