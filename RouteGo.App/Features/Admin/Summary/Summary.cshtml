@page
@model RouteGo.App.Features.Admin.Summary.SummaryModel
@*
    RouteGo-wide figures for a range, counted exactly as the operator dashboard counts them; the
    address always carries from and to (a bare address is sent on to the full one).
*@
@{
    ViewData["Title"] = "Summary";
    ReportRangeCheck check = Model.View.Check;
}

<h1 class="page-title mb-3">Summary</h1>

<form method="get" action="/admin/summary" class="row g-2 align-items-end mb-3 filter-bar" novalidate data-summary-form>
    <div class="col-sm-3">
        <label for="summary-from" class="form-label">From</label>
        <input id="summary-from" name="from" type="date" class="form-control" value="@Model.FromText" />
        @if (check.FromError != null)
        {
            <span class="invalid-feedback d-block" data-from-error>@check.FromError</span>
        }
    </div>
    <div class="col-sm-3">
        <label for="summary-to" class="form-label">To</label>
        <input id="summary-to" name="to" type="date" class="form-control" value="@Model.ToText" />
        @if (check.ToError != null)
        {
            <span class="invalid-feedback d-block" data-to-error>@check.ToError</span>
        }
    </div>
    <div class="col-sm-3">
        <button type="submit" class="btn btn-primary w-100" data-show-figures>Show figures</button>
    </div>
    @if (check.RangeError != null)
    {
        <div class="col-12">
            <span class="invalid-feedback d-block" data-date-range-error>@check.RangeError</span>
        </div>
    }
</form>

<partial name="_PageAlert" model="Model.View.Alert" />

@if (Model.View.Summary != null)
{
    SalesTotals totals = Model.View.Summary.Totals;
    <dl class="row mb-3" data-totals>
        <dt class="col-sm-3">Confirmed bookings</dt><dd class="col-sm-9" data-total="confirmed-bookings">@totals.ConfirmedBookings</dd>
        <dt class="col-sm-3">Confirmed seats</dt><dd class="col-sm-9" data-total="confirmed-seats">@totals.ConfirmedSeats</dd>
        <dt class="col-sm-3">Revenue</dt><dd class="col-sm-9" data-total="revenue">@ReportDisplay.Rupees(totals.Revenue)</dd>
        <dt class="col-sm-3">Refunds</dt><dd class="col-sm-9" data-total="refunds">@ReportDisplay.Rupees(totals.Refunds)</dd>
        <dt class="col-sm-3">Net</dt><dd class="col-sm-9 fw-semibold" data-total="net">@ReportDisplay.Rupees(totals.Net)</dd>
    </dl>

    <div class="table-responsive">
        <table class="table align-middle" data-daily>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Confirmed bookings</th>
                    <th scope="col">Confirmed seats</th>
                    <th scope="col">Revenue</th>
                    <th scope="col">Refunds</th>
                    <th scope="col">Net</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SalesDay day in Model.View.Summary.DailySeries)
                {
                    <tr data-day="@ReportDisplay.WireDate(day.Date)">
                        <td>@IndiaTime.FormatDay(day.Date)</td>
                        <td>@day.ConfirmedBookings</td>
                        <td>@day.ConfirmedSeats</td>
                        <td>@ReportDisplay.Rupees(day.Revenue)</td>
                        <td>@ReportDisplay.Rupees(day.Refunds)</td>
                        <td>@ReportDisplay.Rupees(day.Net)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted" data-revenue-note>@ReportDisplay.RevenueNote</p>
}

<p><a href="/admin/settlements" data-see-settlements>See settlements</a></p>
